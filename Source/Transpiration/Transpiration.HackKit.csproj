<Project Sdk="Meadow.Sdk/1.1.0">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputType>Exe</OutputType>
    <AssemblyName>App</AssemblyName>
    <RootNamespace>Transpiration</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latestmajor</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Services\**" />
    <EmbeddedResource Remove="Services\**" />
    <None Remove="Services\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meadow" Version="0.29.1" />
    <PackageReference Include="Meadow.F7" Version="0.29.1" />
    <PackageReference Include="Meadow.Foundation" Version="0.31.0" />
    <PackageReference Include="Meadow.Foundation.Displays.TextDisplayMenu" Version="0.1.42" />
    <PackageReference Include="Meadow.Foundation.Displays.TftSpi" Version="0.7.50" />
    <PackageReference Include="SimpleJsonSerializer" Version="0.0.2" />
    <PackageReference Include="SimpleJpegDecoder" Version="0.4.0" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="meadow-logo.jpg" />
  </ItemGroup>
  <ItemGroup>
    <None Update="meadow-logo.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="meadow-logo.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Renderers\" />
  </ItemGroup>
  <Import Project="..\Transpiration.Core\Transpiration.Core.projitems" Label="Shared" Condition="Exists('..\Transpiration.Core\Transpiration.Core.projitems')" />
</Project>